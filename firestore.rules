rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Preserved Existing App Collections
    // =========================================================================
    match /users/{userId}/stickers/{stickerId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // =========================================================================
    // CivicLens Hackathon / Demo Mode Security Rules
    // =========================================================================
    // 1. Citizen Reports Collection
    match /civiclens_reports/{reportId} {
      allow read, write: if true;
    }

    // 2. Municipal Hotspots Collection
    match /civiclens_hotspots/{hotspotId} {
      allow read, write: if true;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
