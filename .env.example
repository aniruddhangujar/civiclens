# ==============================================================================
# CivicLens Environment Configuration Template
# Copy this file to .env and configure your variables.
# NEVER commit the real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Vision Provider Configuration (SERVER-SIDE ONLY - NEVER EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
# Provider Selection: 'auto' | 'openrouter' | 'gemini'
# - 'auto': Uses OpenRouter if key is present, falls back to Gemini direct, then deterministic presets.
# - 'openrouter': Queries OpenRouter API with OPENROUTER_MODEL.
# - 'gemini': Queries Google Generative Language API with GEMINI_MODEL.
AI_PROVIDER=auto

# OpenRouter Configuration (Recommended multi-model gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Google Gemini Direct Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Firebase Public Client Configuration (SAFE FOR BROWSER / CLIENT BUNDLE)
# ------------------------------------------------------------------------------
# Note: Variables prefixed with VITE_ are bundled into client JavaScript.
# These values are public Firebase project identifiers, NOT administrative secrets.
# Leave blank to automatically run in Offline LocalStorage Mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 3. Production Server Settings (Optional - Server-side only)
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
